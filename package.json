    "@tanstack/react-router": "^1.170.10",
    "axios": "^1.8.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
