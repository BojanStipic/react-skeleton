    "@tanstack/react-router": "^1.163.3",
    "axios": "^1.13.6",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.3",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
